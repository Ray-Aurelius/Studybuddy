    <string name="wisdom_1">Starzeję się, wciąż ucząc się wielu rzeczy.</string>
    <string name="wisdom_1_who">Solon</string>
    <string name="wisdom_1_source">fragment cytowany przez Platona i Plutarcha</string>
    <string name="wisdom_2">Wszyscy ludzie z natury pragną wiedzy.</string>
    <string name="wisdom_2_who">Arystoteles</string>
    <string name="wisdom_2_source">Metafizyka, księga I</string>
    <string name="wisdom_3">Życie bez badania nie jest warte przeżycia.</string>
    <string name="wisdom_3_who">Sokrates</string>
    <string name="wisdom_3_source">Platon, Obrona Sokratesa</string>
    <string name="wisdom_4">Zdziwienie jest początkiem mądrości.</string>
    <string name="wisdom_4_who">Sokrates</string>
    <string name="wisdom_4_source">Platon, Teajtet</string>
    <string name="wisdom_5">Poznaj samego siebie.</string>
    <string name="wisdom_5_who">Napis w Delfach</string>
    <string name="wisdom_5_source">Świątynia Apollina</string>
    <string name="wisdom_6">Tego, czego trzeba się nauczyć, by to robić, uczymy się, robiąc to.</string>
    <string name="wisdom_6_who">Arystoteles</string>
    <string name="wisdom_6_source">Etyka nikomachejska, księga II</string>
    <string name="wisdom_7">Nie można nauczyć się tego, co się myśli, że się już wie.</string>
    <string name="wisdom_7_who">Epiktet</string>
    <string name="wisdom_7_source">Diatryby, księga II</string>
    <string name="wisdom_8">Nic wielkiego nie powstaje nagle, tak jak nie powstaje nagle winogrono czy figa.</string>
    <string name="wisdom_8_who">Epiktet</string>
    <string name="wisdom_8_source">Diatryby, księga I</string>
    <string name="wisdom_9">Najpierw powiedz sobie, kim chcesz być; potem rób to, co musisz.</string>
    <string name="wisdom_9_who">Epiktet</string>
    <string name="wisdom_9_source">Diatryby, księga III</string>
    <string name="wisdom_10">Korzenie nauki są gorzkie, ale owoce słodkie.</string>
    <string name="wisdom_10_who">Arystoteles</string>
    <string name="wisdom_10_source">według Diogenesa Laertiosa</string>
    <string name="wisdom_11">Wykształcenie to najlepszy zapas na starość.</string>
    <string name="wisdom_11_who">Arystoteles</string>
    <string name="wisdom_11_source">według Diogenesa Laertiosa</string>
    <string name="wisdom_12">Umysł nie jest naczyniem do napełnienia, lecz drewnem do rozpalenia.</string>
    <string name="wisdom_12_who">Plutarch</string>
    <string name="wisdom_12_source">O słuchaniu</string>
    <string name="wisdom_13">Początek to połowa całości.</string>
    <string name="wisdom_13_who">Arystoteles</string>
    <string name="wisdom_13_source">Polityka, księga V</string>
    <string name="wisdom_14">Ćwiczenie jest wszystkim.</string>
    <string name="wisdom_14_who">Periander</string>
    <string name="wisdom_14_source">według Diogenesa Laertiosa</string>
    <string name="wisdom_15">Mamy dwoje uszu i jedne usta, byśmy więcej słuchali, a mniej mówili.</string>
    <string name="wisdom_15_who">Zenon z Kition</string>
    <string name="wisdom_15_source">według Diogenesa Laertiosa</string>
    <string name="wisdom_16">Jakie są twoje zwykłe myśli, taki będzie charakter twojego umysłu.</string>
    <string name="wisdom_16_who">Marek Aureliusz</string>
    <string name="wisdom_16_source">Rozmyślania, księga V</string>
    <string name="wisdom_17">Nie trać już czasu na spory o to, jaki powinien być dobry człowiek. Bądź nim.</string>
    <string name="wisdom_17_who">Marek Aureliusz</string>
    <string name="wisdom_17_source">Rozmyślania, księga X</string>
    <string name="wisdom_18">Nie można dwa razy wejść do tej samej rzeki.</string>
    <string name="wisdom_18_who">Heraklit</string>
    <string name="wisdom_18_source">według Platona, Kratylos</string>
    <string name="tip_1_title">Rozłóż to w czasie</string>
    <string name="tip_1_body">Kilka krótkich sesji w ciągu tygodnia pokonuje jedno długie kucie. Nauka rozłożona w czasie to jedno z najlepiej potwierdzonych odkryć badań nad uczeniem się.</string>
    <string name="tip_2_title">Sprawdzaj się</string>
    <string name="tip_2_body">Po lekturze zamknij książkę i zapisz, co pamiętasz. Przypominanie wzmacnia pamięć znacznie bardziej niż ponowne czytanie.</string>
    <string name="tip_3_title">Przeplataj</string>
    <string name="tip_3_body">Przeplataj tematy lub rodzaje zadań zamiast ćwiczyć jedno naraz. Jest trudniej i właśnie dlatego to działa.</string>
    <string name="tip_4_title">Wytłumacz to</string>
    <string name="tip_4_body">Wyjaśnij pomysł prostymi słowami, jak ciekawemu dwunastolatkowi. Luki w wyjaśnieniu to luki w zrozumieniu.</string>
    <string name="tip_5_title">Ustal kiedy i gdzie</string>
    <string name="tip_5_body">„Uczę się o 19:00 przy kuchennym stole” znacznie zwiększa szansę, że to zrobisz, w porównaniu z „pouczę się wieczorem”.</string>
    <string name="tip_6_title">Prześpij się z tym</string>
    <string name="tip_6_body">Sen utrwala to, czego nauczyłeś się w ciągu dnia. Nocne kucie często kosztuje więcej, niż daje.</string>
    <string name="tip_7_title">Celuj tuż poza strefę komfortu</string>
    <string name="tip_7_body">Wybieraj ćwiczenia odrobinę za trudne. Jeśli jest łatwo, powtarzasz, a nie się uczysz.</string>
    <string name="tip_8_title">Refleksja w jednym zdaniu</string>
    <string name="tip_8_body">Zakończenie sesji „jedną rzeczą, której się nauczyłem” to małe ćwiczenie przypominania, które pokazuje też twoje postępy.</string>
    <string name="tip_9_title">Chroń skupienie</string>
    <string name="tip_9_body">Podczas bloku skupienia zostaw telefon w innym pokoju. Nawet odwrócony na stole potrafi odciągać uwagę.</string>
    <string name="tip_10_title">Połącz to</string>
    <string name="tip_10_body">Zapytaj siebie: „Jak to się łączy z czymś, co już wiem?” Powiązane idee łatwiej później przywołać.</string>
    <string name="tip_11_title">Wybaczaj przerwy</string>
    <string name="tip_11_body">Jeden opuszczony dzień nie niszczy nawyku. Liczy się powrót następnego dnia.</string>
    <string name="tip_12_title">Słowa + obrazy</string>
    <string name="tip_12_body">Naszkicuj szybki schemat tego, czego się uczysz. Obrazy i słowa razem dają pamięci dwie drogi.</string>
    <string name="tip_13_title">Pytaj dlaczego</string>
    <string name="tip_13_body">Czytając, ciągle pytaj: „Dlaczego to prawda?” Samodzielne wyjaśnianie zamienia fakty w zrozumienie.</string>
    <string name="tip_14_title">Zakończ planem</string>
    <string name="tip_14_body">Na koniec każdej sesji zanotuj, od czego zaczniesz następnym razem. Początek jest najtrudniejszy, więc ułatw go sobie z przyszłości.</string>
