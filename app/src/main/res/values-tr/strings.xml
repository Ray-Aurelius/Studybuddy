    <string name="wisdom_5_source">Apollon Tapınağı</string>
    <string name="wisdom_6">Yapabilmek için öğrenmemiz gerekenleri, yaparak öğreniriz.</string>
    <string name="wisdom_6_who">Aristoteles</string>
    <string name="wisdom_6_source">Nikomakhos\'a Etik, II. kitap</string>
    <string name="wisdom_7">Zaten bildiğini sandığın bir şeyi öğrenmen imkânsızdır.</string>
    <string name="wisdom_7_who">Epiktetos</string>
    <string name="wisdom_7_source">Söylevler, II. kitap</string>
    <string name="wisdom_8">Büyük hiçbir şey birden ortaya çıkmaz; bir salkım üzüm ya da bir incir bile.</string>
    <string name="wisdom_8_who">Epiktetos</string>
    <string name="wisdom_8_source">Söylevler, I. kitap</string>
    <string name="wisdom_9">Önce kendine ne olmak istediğini söyle; sonra yapman gerekeni yap.</string>
    <string name="wisdom_9_who">Epiktetos</string>
    <string name="wisdom_9_source">Söylevler, III. kitap</string>
    <string name="wisdom_10">Eğitimin kökleri acıdır, ama meyvesi tatlıdır.</string>
    <string name="wisdom_10_who">Aristoteles</string>
    <string name="wisdom_10_source">Diogenes Laertios\'a göre</string>
    <string name="wisdom_11">Eğitim, yaşlılık için en iyi azıktır.</string>
    <string name="wisdom_11_who">Aristoteles</string>
    <string name="wisdom_11_source">Diogenes Laertios\'a göre</string>
    <string name="wisdom_12">Zihin doldurulacak bir kap değil, tutuşturulacak bir odundur.</string>
    <string name="wisdom_12_who">Plutarkhos</string>
    <string name="wisdom_12_source">Dinlemek üzerine</string>
    <string name="wisdom_13">Başlangıç, bütünün yarısıdır.</string>
    <string name="wisdom_13_who">Aristoteles</string>
    <string name="wisdom_13_source">Politika, V. kitap</string>
    <string name="wisdom_14">Alıştırma her şeydir.</string>
    <string name="wisdom_14_who">Periandros</string>
    <string name="wisdom_14_source">Diogenes Laertios\'a göre</string>
    <string name="wisdom_15">İki kulağımız ve bir ağzımız var; daha çok dinleyip daha az konuşalım diye.</string>
    <string name="wisdom_15_who">Kıbrıslı Zenon</string>
    <string name="wisdom_15_source">Diogenes Laertios\'a göre</string>
    <string name="wisdom_16">Alışkın olduğun düşünceler neyse, zihninin karakteri de o olur.</string>
    <string name="wisdom_16_who">Marcus Aurelius</string>
    <string name="wisdom_16_source">Düşünceler, V. kitap</string>
    <string name="wisdom_17">İyi bir insanın nasıl olması gerektiğini tartışarak daha fazla zaman kaybetme. Öyle biri ol.</string>
    <string name="wisdom_17_who">Marcus Aurelius</string>
    <string name="wisdom_17_source">Düşünceler, X. kitap</string>
    <string name="wisdom_18">Aynı nehre iki kez giremezsin.</string>
    <string name="wisdom_18_who">Herakleitos</string>
    <string name="wisdom_18_source">Platon\'a göre, Kratylos</string>
    <string name="tip_1_title">Yay</string>
    <string name="tip_1_body">Haftaya yayılmış birkaç kısa oturum, tek bir uzun son dakika çalışmasından iyidir. Aralıklı pratik, öğrenme araştırmalarının en sağlam bulgularından biridir.</string>
    <string name="tip_2_title">Kendini sına</string>
    <string name="tip_2_body">Okuduktan sonra kitabı kapat ve hatırladıklarını yaz. Hatırlamaya çalışmak belleği tekrar okumaktan çok daha fazla güçlendirir.</string>
    <string name="tip_3_title">Karıştır</string>
    <string name="tip_3_body">Konuları ya da problem türlerini tek tek çalışmak yerine dönüşümlü çalış. Daha zor gelir; işe yaramasının sebebi de budur.</string>
    <string name="tip_4_title">Anlat</string>
    <string name="tip_4_body">Fikri, meraklı on iki yaşında birine anlatır gibi basit kelimelerle anlat. Anlatımındaki boşluklar, anlayışındaki boşluklardır.</string>
    <string name="tip_5_title">Ne zaman ve nerede olacağını belirle</string>
    <string name="tip_5_body">\"Saat 19.00\'da mutfak masasında çalışacağım\" demek, \"bu akşam çalışırım\" demekten çok daha fazla yapma olasılığı sağlar.</string>
    <string name="tip_6_title">Üzerine uyu</string>
    <string name="tip_6_body">Uyku, gün içinde öğrendiklerini pekiştirir. Gece geç saatlere kadar ders çalışmak çoğu zaman kazandırdığından fazlasını götürür.</string>
    <string name="tip_7_title">Konforun biraz ötesi</string>
    <string name="tip_7_body">Biraz fazla zor gelen alıştırmaları seç. Kolay geliyorsa öğrenmiyor, tekrar ediyorsun.</string>
    <string name="tip_8_title">Tek satırlık değerlendirme</string>
    <string name="tip_8_body">Bir oturumu \"öğrendiğim bir şey\" ile bitirmek, ilerlemeni de gösteren küçük bir hatırlama alıştırmasıdır.</string>
    <string name="tip_9_title">Odağını koru</string>
    <string name="tip_9_body">Odak bloğu sırasında telefonunu başka bir odaya koy. Masada ters çevrili dursa bile dikkatini dağıtabilir.</string>
    <string name="tip_10_title">Bağlantı kur</string>
    <string name="tip_10_body">Kendine sor: \"Bu, zaten bildiğim bir şeyle nasıl bağlantılı?\" Bağlantılı fikirler sonradan daha kolay hatırlanır.</string>
    <string name="tip_11_title">Aksamaları affet</string>
    <string name="tip_11_body">Kaçırılan bir gün alışkanlığı bozmaz. Önemli olan ertesi gün devam etmektir.</string>
    <string name="tip_12_title">Kelimeler + görseller</string>
    <string name="tip_12_body">Öğrendiğin şeyin hızlı bir şemasını çiz. Görseller ve kelimeler birlikte belleğe iki giriş yolu açar.</string>
    <string name="tip_13_title">Nedenini sor</string>
    <string name="tip_13_body">Okurken kendine sürekli sor: \"Bu neden doğru?\" Kendi kendine açıklama, bilgiyi anlayışa dönüştürür.</string>
    <string name="tip_14_title">Bir planla bitir</string>
    <string name="tip_14_body">Her oturumun sonunda bir dahaki sefere nereden başlayacağını not et. Başlamak en zor kısımdır; gelecekteki kendin için kolaylaştır.</string>
