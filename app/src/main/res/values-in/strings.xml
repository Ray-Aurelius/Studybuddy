    <string name="wisdom_1">Aku menua sambil terus mempelajari banyak hal.</string>
    <string name="wisdom_1_who">Solon</string>
    <string name="wisdom_1_source">fragmen, dikutip Plato dan Plutarkhos</string>
    <string name="wisdom_2">Semua manusia secara kodrati ingin mengetahui.</string>
    <string name="wisdom_2_who">Aristoteles</string>
    <string name="wisdom_2_source">Metafisika, Buku I</string>
    <string name="wisdom_3">Hidup yang tidak diperiksa tidak layak dijalani.</string>
    <string name="wisdom_3_who">Sokrates</string>
    <string name="wisdom_3_source">Plato, Apologia</string>
    <string name="wisdom_4">Rasa takjub adalah awal kebijaksanaan.</string>
    <string name="wisdom_4_who">Sokrates</string>
    <string name="wisdom_4_source">Plato, Theaitetos</string>
    <string name="wisdom_5">Kenali dirimu.</string>
    <string name="wisdom_5_who">Prasasti Delfi</string>
    <string name="wisdom_5_source">Kuil Apollo</string>
    <string name="wisdom_6">Hal-hal yang harus kita pelajari sebelum bisa melakukannya, kita pelajari dengan melakukannya.</string>
    <string name="wisdom_6_who">Aristoteles</string>
    <string name="wisdom_6_source">Etika Nikomakhea, Buku II</string>
    <string name="wisdom_7">Mustahil mempelajari sesuatu yang kamu kira sudah kamu ketahui.</string>
    <string name="wisdom_7_who">Epiktetos</string>
    <string name="wisdom_7_source">Diskursus, Buku II</string>
    <string name="wisdom_8">Tak ada hal besar yang tercipta tiba-tiba, bahkan setandan anggur atau sebuah ara pun tidak.</string>
    <string name="wisdom_8_who">Epiktetos</string>
    <string name="wisdom_8_source">Diskursus, Buku I</string>
    <string name="wisdom_9">Katakan dulu pada dirimu ingin menjadi apa; lalu lakukan apa yang harus dilakukan.</string>
    <string name="wisdom_9_who">Epiktetos</string>
    <string name="wisdom_9_source">Diskursus, Buku III</string>
    <string name="wisdom_10">Akar pendidikan itu pahit, tetapi buahnya manis.</string>
    <string name="wisdom_10_who">Aristoteles</string>
    <string name="wisdom_10_source">menurut Diogenes Laertios</string>
    <string name="wisdom_11">Pendidikan adalah bekal terbaik untuk hari tua.</string>
    <string name="wisdom_11_who">Aristoteles</string>
    <string name="wisdom_11_source">menurut Diogenes Laertios</string>
    <string name="wisdom_12">Pikiran bukan wadah untuk diisi, melainkan kayu untuk dinyalakan.</string>
    <string name="wisdom_12_who">Plutarkhos</string>
    <string name="wisdom_12_source">Tentang Mendengarkan</string>
    <string name="wisdom_13">Permulaan adalah separuh dari keseluruhan.</string>
    <string name="wisdom_13_who">Aristoteles</string>
    <string name="wisdom_13_source">Politik, Buku V</string>
    <string name="wisdom_14">Latihan adalah segalanya.</string>
    <string name="wisdom_14_who">Periandros</string>
    <string name="wisdom_14_source">menurut Diogenes Laertios</string>
    <string name="wisdom_15">Kita punya dua telinga dan satu mulut, agar lebih banyak mendengar dan sedikit bicara.</string>
    <string name="wisdom_15_who">Zeno dari Kition</string>
    <string name="wisdom_15_source">menurut Diogenes Laertios</string>
    <string name="wisdom_16">Seperti apa pikiran yang biasa kamu pikirkan, seperti itulah watak pikiranmu.</string>
    <string name="wisdom_16_who">Marcus Aurelius</string>
    <string name="wisdom_16_source">Meditasi, Buku V</string>
    <string name="wisdom_17">Jangan lagi buang waktu berdebat tentang seperti apa orang baik itu. Jadilah orang baik.</string>
    <string name="wisdom_17_who">Marcus Aurelius</string>
    <string name="wisdom_17_source">Meditasi, Buku X</string>
    <string name="wisdom_18">Kamu tidak bisa melangkah ke sungai yang sama dua kali.</string>
    <string name="wisdom_18_who">Herakleitos</string>
    <string name="wisdom_18_source">menurut Plato, Kratylos</string>
    <string name="tip_1_title">Sebar waktunya</string>
    <string name="tip_1_body">Beberapa sesi singkat sepanjang minggu lebih baik daripada satu sesi kebut semalam. Latihan berjarak termasuk temuan paling kuat dalam riset belajar.</string>
    <string name="tip_2_title">Uji dirimu</string>
    <string name="tip_2_body">Setelah membaca, tutup buku dan tulis apa yang kamu ingat. Mengingat kembali memperkuat memori jauh lebih baik daripada membaca ulang.</string>
    <string name="tip_3_title">Campur</string>
    <string name="tip_3_body">Selang-seling topik atau jenis soal alih-alih berlatih satu per satu. Terasa lebih sulit, dan justru karena itu berhasil.</string>
    <string name="tip_4_title">Jelaskan</string>
    <string name="tip_4_body">Jelaskan idenya dengan kata-kata sederhana, seperti kepada anak dua belas tahun yang penasaran. Celah dalam penjelasanmu adalah celah dalam pemahamanmu.</string>
    <string name="tip_5_title">Tentukan kapan dan di mana</string>
    <string name="tip_5_body">\"Aku akan belajar pukul 19.00 di meja dapur\" jauh lebih mungkin terlaksana daripada \"nanti malam aku belajar\".</string>
    <string name="tip_6_title">Tidurlah</string>
    <string name="tip_6_body">Tidur memantapkan apa yang kamu pelajari hari itu. Begadang belajar sering lebih merugikan daripada menguntungkan.</string>
    <string name="tip_7_title">Sedikit di atas nyaman</string>
    <string name="tip_7_body">Pilih latihan yang sedikit terlalu sulit. Kalau terasa mudah, kamu sedang mengulang, bukan belajar.</string>
    <string name="tip_8_title">Refleksi satu baris</string>
    <string name="tip_8_body">Mengakhiri sesi dengan \"satu hal yang kupelajari\" adalah latihan mengingat kecil yang juga menunjukkan kemajuanmu.</string>
    <string name="tip_9_title">Lindungi fokusmu</string>
    <string name="tip_9_body">Taruh ponsel di ruangan lain selama blok fokus. Bahkan tertelungkup di meja pun bisa mengganggu perhatian.</string>
    <string name="tip_10_title">Hubungkan</string>
    <string name="tip_10_body">Tanyakan: \"Bagaimana ini terhubung dengan sesuatu yang sudah kutahu?\" Ide yang terhubung lebih mudah diingat nanti.</string>
    <string name="tip_11_title">Maafkan jeda</string>
    <string name="tip_11_body">Satu hari terlewat tidak merusak kebiasaan. Yang penting kembali keesokan harinya.</string>
    <string name="tip_12_title">Kata + gambar</string>
    <string name="tip_12_body">Buat sketsa diagram singkat dari yang kamu pelajari. Gambar dan kata bersama-sama memberi memori dua jalan masuk.</string>
    <string name="tip_13_title">Tanyakan kenapa</string>
    <string name="tip_13_body">Saat membaca, terus tanyakan: \"Kenapa ini benar?\" Menjelaskan pada diri sendiri mengubah fakta menjadi pemahaman.</string>
    <string name="tip_14_title">Tutup dengan rencana</string>
    <string name="tip_14_body">Di akhir setiap sesi, catat dari mana kamu akan mulai lain kali. Memulai adalah bagian tersulit, jadi mudahkan untuk dirimu di masa depan.</string>
