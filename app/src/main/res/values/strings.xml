    <!-- Daily wisdom (ancient Greek sayings; translate the meaning faithfully) -->
    <string name="wisdom_1">I grow old ever learning many things.</string>
    <string name="wisdom_1_who">Solon</string>
    <string name="wisdom_1_source">fragment, quoted by Plato and Plutarch</string>
    <string name="wisdom_2">All people by nature desire to know.</string>
    <string name="wisdom_2_who">Aristotle</string>
    <string name="wisdom_2_source">Metaphysics, Book I</string>
    <string name="wisdom_3">The unexamined life is not worth living.</string>
    <string name="wisdom_3_who">Socrates</string>
    <string name="wisdom_3_source">Plato, Apology</string>
    <string name="wisdom_4">Wonder is the beginning of wisdom.</string>
    <string name="wisdom_4_who">Socrates</string>
    <string name="wisdom_4_source">Plato, Theaetetus</string>
    <string name="wisdom_5">Know thyself.</string>
    <string name="wisdom_5_who">Inscription at Delphi</string>
    <string name="wisdom_5_source">Temple of Apollo</string>
    <string name="wisdom_6">What we have to learn to do, we learn by doing.</string>
    <string name="wisdom_6_who">Aristotle</string>
    <string name="wisdom_6_source">Nicomachean Ethics, Book II</string>
    <string name="wisdom_7">It is impossible to learn what you think you already know.</string>
    <string name="wisdom_7_who">Epictetus</string>
    <string name="wisdom_7_source">Discourses, Book II</string>
    <string name="wisdom_8">No great thing is created suddenly, any more than a bunch of grapes or a fig.</string>
    <string name="wisdom_8_who">Epictetus</string>
    <string name="wisdom_8_source">Discourses, Book I</string>
    <string name="wisdom_9">First say to yourself what you would be; then do what you have to do.</string>
    <string name="wisdom_9_who">Epictetus</string>
    <string name="wisdom_9_source">Discourses, Book III</string>
    <string name="wisdom_10">The roots of education are bitter, but the fruit is sweet.</string>
    <string name="wisdom_10_who">Aristotle</string>
    <string name="wisdom_10_source">as quoted by Diogenes Laërtius</string>
    <string name="wisdom_11">Education is the best provision for old age.</string>
    <string name="wisdom_11_who">Aristotle</string>
    <string name="wisdom_11_source">as quoted by Diogenes Laërtius</string>
    <string name="wisdom_12">The mind is not a vessel to be filled, but wood to be kindled.</string>
    <string name="wisdom_12_who">Plutarch</string>
    <string name="wisdom_12_source">On Listening to Lectures</string>
    <string name="wisdom_13">The beginning is half of the whole.</string>
    <string name="wisdom_13_who">Aristotle</string>
    <string name="wisdom_13_source">Politics, Book V</string>
    <string name="wisdom_14">Practice is everything.</string>
    <string name="wisdom_14_who">Periander</string>
    <string name="wisdom_14_source">as quoted by Diogenes Laërtius</string>
    <string name="wisdom_15">We have two ears and one mouth, so we may listen more and speak less.</string>
    <string name="wisdom_15_who">Zeno of Citium</string>
    <string name="wisdom_15_source">as quoted by Diogenes Laërtius</string>
    <string name="wisdom_16">As are your habitual thoughts, so will be the character of your mind.</string>
    <string name="wisdom_16_who">Marcus Aurelius</string>
    <string name="wisdom_16_source">Meditations, Book V</string>
    <string name="wisdom_17">Waste no more time arguing what a good person should be. Be one.</string>
    <string name="wisdom_17_who">Marcus Aurelius</string>
    <string name="wisdom_17_source">Meditations, Book X</string>
    <string name="wisdom_18">You cannot step into the same river twice.</string>
    <string name="wisdom_18_who">Heraclitus</string>
    <string name="wisdom_18_source">as reported by Plato, Cratylus</string>

    <!-- Learning tips -->
    <string name="tip_1_title">Space it out</string>
    <string name="tip_1_body">Several short sessions across the week beat one long cram. Spacing is one of the most replicated findings in learning science.</string>
    <string name="tip_2_title">Test yourself</string>
    <string name="tip_2_body">After reading, close the book and write down what you remember. Retrieval strengthens memory far more than re-reading.</string>
    <string name="tip_3_title">Mix it up</string>
    <string name="tip_3_body">Interleave topics or problem types instead of drilling one at a time. It feels harder, and that\'s why it works.</string>
    <string name="tip_4_title">Teach it back</string>
    <string name="tip_4_body">Explain the idea in plain words as if to a curious 12-year-old. Gaps in your explanation are gaps in your understanding.</string>
    <string name="tip_5_title">Decide when and where</string>
    <string name="tip_5_body">\"I\'ll learn at 7 pm at the kitchen table\" makes you far more likely to follow through than \"I\'ll get to it tonight.\"</string>
    <string name="tip_6_title">Sleep on it</string>
    <string name="tip_6_body">Sleep consolidates what you learned during the day. A late-night cram often costs more than it gains.</string>
    <string name="tip_7_title">Aim just past comfortable</string>
    <string name="tip_7_body">Pick practice that\'s slightly too hard. If it feels easy, you\'re rehearsing, not learning.</string>
    <string name="tip_8_title">One-line reflection</string>
    <string name="tip_8_body">Ending a session with \"one thing I learned\" is a tiny retrieval exercise that also shows you your progress.</string>
    <string name="tip_9_title">Guard your focus</string>
    <string name="tip_9_body">Put your phone in another room for a focus block. Even a phone face-down on the desk can drain attention.</string>
    <string name="tip_10_title">Connect it</string>
    <string name="tip_10_body">Ask \"how does this relate to something I already know?\" Linked ideas are easier to recall later.</string>
    <string name="tip_11_title">Go easy on misses</string>
    <string name="tip_11_body">Missing a day doesn\'t break a habit. What matters is getting back on track the next day.</string>
    <string name="tip_12_title">Words + pictures</string>
    <string name="tip_12_body">Sketch a quick diagram of what you\'re learning. Combining visuals with words gives memory two paths in.</string>
    <string name="tip_13_title">Ask why</string>
    <string name="tip_13_body">Keep asking \"why is this true?\" as you read. Self-explanation turns facts into understanding.</string>
    <string name="tip_14_title">Finish with a plan</string>
    <string name="tip_14_body">End each session by noting where to start next time. Starting is the hardest part — make it easy for future you.</string>

