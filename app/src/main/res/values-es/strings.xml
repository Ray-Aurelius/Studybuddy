    <string name="wisdom_1">Envejezco aprendiendo siempre muchas cosas.</string>
    <string name="wisdom_1_who">Solón</string>
    <string name="wisdom_1_source">fragmento, citado por Platón y Plutarco</string>
    <string name="wisdom_2">Todos los seres humanos desean por naturaleza saber.</string>
    <string name="wisdom_2_who">Aristóteles</string>
    <string name="wisdom_2_source">Metafísica, libro I</string>
    <string name="wisdom_3">Una vida sin examen no merece ser vivida.</string>
    <string name="wisdom_3_who">Sócrates</string>
    <string name="wisdom_3_source">Platón, Apología</string>
    <string name="wisdom_4">El asombro es el comienzo de la sabiduría.</string>
    <string name="wisdom_4_who">Sócrates</string>
    <string name="wisdom_4_source">Platón, Teeteto</string>
    <string name="wisdom_5">Conócete a ti mismo.</string>
    <string name="wisdom_5_who">Inscripción de Delfos</string>
    <string name="wisdom_5_source">Templo de Apolo</string>
    <string name="wisdom_6">Lo que hay que aprender a hacer, lo aprendemos haciéndolo.</string>
    <string name="wisdom_6_who">Aristóteles</string>
    <string name="wisdom_6_source">Ética a Nicómaco, libro II</string>
    <string name="wisdom_7">Es imposible aprender lo que uno cree que ya sabe.</string>
    <string name="wisdom_7_who">Epicteto</string>
    <string name="wisdom_7_source">Disertaciones, libro II</string>
    <string name="wisdom_8">Nada grande se crea de repente, como tampoco un racimo de uvas o un higo.</string>
    <string name="wisdom_8_who">Epicteto</string>
    <string name="wisdom_8_source">Disertaciones, libro I</string>
    <string name="wisdom_9">Primero dite a ti mismo qué quieres ser; luego haz lo que tengas que hacer.</string>
    <string name="wisdom_9_who">Epicteto</string>
    <string name="wisdom_9_source">Disertaciones, libro III</string>
    <string name="wisdom_10">Las raíces de la educación son amargas, pero el fruto es dulce.</string>
    <string name="wisdom_10_who">Aristóteles</string>
    <string name="wisdom_10_source">según Diógenes Laercio</string>
    <string name="wisdom_11">La educación es la mejor provisión para la vejez.</string>
    <string name="wisdom_11_who">Aristóteles</string>
    <string name="wisdom_11_source">según Diógenes Laercio</string>
    <string name="wisdom_12">La mente no es un vaso que llenar, sino una leña que encender.</string>
    <string name="wisdom_12_who">Plutarco</string>
    <string name="wisdom_12_source">Sobre cómo escuchar</string>
    <string name="wisdom_13">El comienzo es la mitad del todo.</string>
    <string name="wisdom_13_who">Aristóteles</string>
    <string name="wisdom_13_source">Política, libro V</string>
    <string name="wisdom_14">La práctica lo es todo.</string>
    <string name="wisdom_14_who">Periandro</string>
    <string name="wisdom_14_source">según Diógenes Laercio</string>
    <string name="wisdom_15">Tenemos dos oídos y una boca para escuchar más y hablar menos.</string>
    <string name="wisdom_15_who">Zenón de Citio</string>
    <string name="wisdom_15_source">según Diógenes Laercio</string>
    <string name="wisdom_16">Como sean tus pensamientos habituales, así será el carácter de tu mente.</string>
    <string name="wisdom_16_who">Marco Aurelio</string>
    <string name="wisdom_16_source">Meditaciones, libro V</string>
    <string name="wisdom_17">No pierdas más tiempo discutiendo cómo debe ser una buena persona. Sé una.</string>
    <string name="wisdom_17_who">Marco Aurelio</string>
    <string name="wisdom_17_source">Meditaciones, libro X</string>
    <string name="wisdom_18">No puedes bañarte dos veces en el mismo río.</string>
    <string name="wisdom_18_who">Heráclito</string>
    <string name="wisdom_18_source">según Platón, Crátilo</string>
    <string name="tip_1_title">Espácialo</string>
    <string name="tip_1_body">Varias sesiones cortas a lo largo de la semana superan a un largo atracón. El espaciado es uno de los hallazgos más replicados de la ciencia del aprendizaje.</string>
    <string name="tip_2_title">Ponte a prueba</string>
    <string name="tip_2_body">Después de leer, cierra el libro y escribe lo que recuerdes. Recuperar fortalece la memoria mucho más que releer.</string>
    <string name="tip_3_title">Mézclalo</string>
    <string name="tip_3_body">Intercala temas o tipos de problemas en lugar de practicar uno a la vez. Se siente más difícil, y por eso funciona.</string>
    <string name="tip_4_title">Enséñalo</string>
    <string name="tip_4_body">Explica la idea con palabras sencillas, como a un niño curioso de 12 años. Los huecos en tu explicación son huecos en tu comprensión.</string>
    <string name="tip_5_title">Decide cuándo y dónde</string>
    <string name="tip_5_body">\"Aprenderé a las 7 en la mesa de la cocina\" te hace mucho más propenso a cumplir que \"ya lo haré esta noche\".</string>
    <string name="tip_6_title">Consúltalo con la almohada</string>
    <string name="tip_6_body">El sueño consolida lo que aprendiste durante el día. Estudiar a última hora suele costar más de lo que aporta.</string>
    <string name="tip_7_title">Apunta un poco más allá de lo cómodo</string>
    <string name="tip_7_body">Elige una práctica un poco demasiado difícil. Si se siente fácil, estás repasando, no aprendiendo.</string>
    <string name="tip_8_title">Reflexión de una línea</string>
    <string name="tip_8_body">Terminar una sesión con \"una cosa que aprendí\" es un pequeño ejercicio de recuperación que además te muestra tu progreso.</string>
    <string name="tip_9_title">Protege tu enfoque</string>
    <string name="tip_9_body">Deja el teléfono en otra habitación durante un bloque de enfoque. Incluso boca abajo sobre la mesa puede restarte atención.</string>
    <string name="tip_10_title">Conéctalo</string>
    <string name="tip_10_body">Pregúntate \"¿cómo se relaciona esto con algo que ya sé?\". Las ideas conectadas son más fáciles de recordar.</string>
    <string name="tip_11_title">Sé amable con los fallos</string>
    <string name="tip_11_body">Saltarte un día no rompe un hábito. Lo que importa es retomarlo al día siguiente.</string>
    <string name="tip_12_title">Palabras + imágenes</string>
    <string name="tip_12_body">Dibuja un diagrama rápido de lo que aprendes. Combinar imágenes y palabras le da a la memoria dos caminos de entrada.</string>
    <string name="tip_13_title">Pregunta por qué</string>
    <string name="tip_13_body">Pregúntate \"¿por qué es cierto esto?\" mientras lees. Explicártelo convierte los datos en comprensión.</string>
    <string name="tip_14_title">Termina con un plan</string>
    <string name="tip_14_body">Cierra cada sesión anotando por dónde empezar la próxima vez. Empezar es lo más difícil: hazlo fácil para tu yo futuro.</string>
