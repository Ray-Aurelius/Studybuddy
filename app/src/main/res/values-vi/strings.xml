    <string name="wisdom_1">Tôi già đi trong khi vẫn luôn học được nhiều điều.</string>
    <string name="wisdom_1_who">Solon</string>
    <string name="wisdom_1_source">đoạn trích, Plato và Plutarch dẫn lại</string>
    <string name="wisdom_2">Mọi người theo bản tính đều khao khát hiểu biết.</string>
    <string name="wisdom_2_who">Aristotle</string>
    <string name="wisdom_2_source">Siêu hình học, Quyển I</string>
    <string name="wisdom_3">Một cuộc đời không được tự vấn thì không đáng sống.</string>
    <string name="wisdom_3_who">Socrates</string>
    <string name="wisdom_3_source">Plato, Biện hộ</string>
    <string name="wisdom_4">Sự kinh ngạc là khởi đầu của trí tuệ.</string>
    <string name="wisdom_4_who">Socrates</string>
    <string name="wisdom_4_source">Plato, Theaetetus</string>
    <string name="wisdom_5">Hãy biết chính mình.</string>
    <string name="wisdom_5_who">Lời khắc ở Delphi</string>
    <string name="wisdom_5_source">Đền thờ Apollo</string>
    <string name="wisdom_6">Những gì ta phải học trước khi làm được, ta học bằng cách làm.</string>
    <string name="wisdom_6_who">Aristotle</string>
    <string name="wisdom_6_source">Đạo đức học Nicomachean, Quyển II</string>
    <string name="wisdom_7">Không thể học điều mà ta nghĩ mình đã biết.</string>
    <string name="wisdom_7_who">Epictetus</string>
    <string name="wisdom_7_source">Diễn từ, Quyển II</string>
    <string name="wisdom_8">Không điều gì vĩ đại hình thành trong chốc lát, kể cả một chùm nho hay một quả sung.</string>
    <string name="wisdom_8_who">Epictetus</string>
    <string name="wisdom_8_source">Diễn từ, Quyển I</string>
    <string name="wisdom_9">Trước hết hãy tự nhủ bạn muốn trở thành ai; rồi làm những gì phải làm.</string>
    <string name="wisdom_9_who">Epictetus</string>
    <string name="wisdom_9_source">Diễn từ, Quyển III</string>
    <string name="wisdom_10">Rễ của giáo dục thì đắng, nhưng quả thì ngọt.</string>
    <string name="wisdom_10_who">Aristotle</string>
    <string name="wisdom_10_source">theo Diogenes Laërtius</string>
    <string name="wisdom_11">Giáo dục là hành trang tốt nhất cho tuổi già.</string>
    <string name="wisdom_11_who">Aristotle</string>
    <string name="wisdom_11_source">theo Diogenes Laërtius</string>
    <string name="wisdom_12">Tâm trí không phải chiếc bình cần rót đầy, mà là củi cần nhóm lửa.</string>
    <string name="wisdom_12_who">Plutarch</string>
    <string name="wisdom_12_source">Bàn về việc lắng nghe</string>
    <string name="wisdom_13">Khởi đầu là một nửa của toàn bộ.</string>
    <string name="wisdom_13_who">Aristotle</string>
    <string name="wisdom_13_source">Chính trị học, Quyển V</string>
    <string name="wisdom_14">Luyện tập là tất cả.</string>
    <string name="wisdom_14_who">Periander</string>
    <string name="wisdom_14_source">theo Diogenes Laërtius</string>
    <string name="wisdom_15">Ta có hai tai và một miệng để nghe nhiều hơn và nói ít hơn.</string>
    <string name="wisdom_15_who">Zeno xứ Citium</string>
    <string name="wisdom_15_source">theo Diogenes Laërtius</string>
    <string name="wisdom_16">Những suy nghĩ thường ngày của bạn thế nào, tâm trí bạn sẽ mang tính cách như thế.</string>
    <string name="wisdom_16_who">Marcus Aurelius</string>
    <string name="wisdom_16_source">Suy tưởng, Quyển V</string>
    <string name="wisdom_17">Đừng phí thêm thời gian tranh luận người tốt phải ra sao. Hãy là người tốt.</string>
    <string name="wisdom_17_who">Marcus Aurelius</string>
    <string name="wisdom_17_source">Suy tưởng, Quyển X</string>
    <string name="wisdom_18">Không ai tắm hai lần trên cùng một dòng sông.</string>
    <string name="wisdom_18_who">Heraclitus</string>
    <string name="wisdom_18_source">theo Plato, Cratylus</string>
    <string name="tip_1_title">Chia nhỏ ra</string>
    <string name="tip_1_body">Vài buổi học ngắn rải trong tuần hiệu quả hơn một buổi nhồi nhét dài. Luyện tập giãn cách là một trong những phát hiện vững chắc nhất của nghiên cứu về học tập.</string>
    <string name="tip_2_title">Tự kiểm tra</string>
    <string name="tip_2_body">Sau khi đọc, gấp sách lại và viết ra những gì bạn nhớ. Gợi nhớ củng cố trí nhớ tốt hơn nhiều so với đọc lại.</string>
    <string name="tip_3_title">Xen kẽ</string>
    <string name="tip_3_body">Luân phiên các chủ đề hoặc dạng bài thay vì luyện từng loại một. Cảm giác khó hơn, và chính vì thế mà hiệu quả.</string>
    <string name="tip_4_title">Giải thích lại</string>
    <string name="tip_4_body">Giải thích ý tưởng bằng lời đơn giản, như cho một đứa trẻ mười hai tuổi tò mò. Lỗ hổng trong lời giải thích là lỗ hổng trong hiểu biết.</string>
    <string name="tip_5_title">Định rõ khi nào và ở đâu</string>
    <string name="tip_5_body">\"Tôi sẽ học lúc 7 giờ tối ở bàn bếp\" khiến bạn dễ thực hiện hơn nhiều so với \"tối nay tôi sẽ học\".</string>
    <string name="tip_6_title">Ngủ một giấc</string>
    <string name="tip_6_body">Giấc ngủ củng cố những gì bạn học trong ngày. Thức khuya ôn dồn thường mất nhiều hơn được.</string>
    <string name="tip_7_title">Nhỉnh hơn mức thoải mái</string>
    <string name="tip_7_body">Chọn bài tập hơi khó một chút. Nếu thấy dễ, bạn đang ôn lại chứ không phải đang học.</string>
    <string name="tip_8_title">Suy ngẫm một dòng</string>
    <string name="tip_8_body">Kết thúc buổi học bằng \"một điều tôi đã học\" là một bài tập gợi nhớ nhỏ, đồng thời cho bạn thấy sự tiến bộ.</string>
    <string name="tip_9_title">Bảo vệ sự tập trung</string>
    <string name="tip_9_body">Để điện thoại ở phòng khác trong khối tập trung. Ngay cả úp trên bàn, nó vẫn có thể làm bạn xao nhãng.</string>
    <string name="tip_10_title">Kết nối</string>
    <string name="tip_10_body">Hỏi: \"Điều này liên quan thế nào đến những gì mình đã biết?\" Ý tưởng được kết nối sẽ dễ nhớ lại hơn.</string>
    <string name="tip_11_title">Tha thứ cho những lần lỡ</string>
    <string name="tip_11_body">Bỏ lỡ một ngày không phá hỏng thói quen. Điều quan trọng là tiếp tục vào ngày hôm sau.</string>
    <string name="tip_12_title">Chữ + hình</string>
    <string name="tip_12_body">Phác nhanh một sơ đồ về điều bạn đang học. Hình ảnh và chữ cùng nhau cho trí nhớ hai lối vào.</string>
    <string name="tip_13_title">Hỏi tại sao</string>
    <string name="tip_13_body">Khi đọc, liên tục tự hỏi: \"Vì sao điều này đúng?\" Tự giải thích biến sự kiện thành hiểu biết.</string>
    <string name="tip_14_title">Kết thúc bằng một kế hoạch</string>
    <string name="tip_14_body">Cuối mỗi buổi, ghi lại lần sau bạn sẽ bắt đầu từ đâu. Bắt đầu là phần khó nhất, hãy làm nó dễ dàng cho chính bạn trong tương lai.</string>
