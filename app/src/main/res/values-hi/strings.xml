    <string name="wisdom_1">मैं बूढ़ा होता जाता हूँ, पर हमेशा बहुत कुछ सीखता रहता हूँ।</string>
    <string name="wisdom_1_who">सोलन</string>
    <string name="wisdom_1_source">अंश, प्लेटो और प्लूटार्क द्वारा उद्धृत</string>
    <string name="wisdom_2">सभी मनुष्य स्वभाव से जानना चाहते हैं।</string>
    <string name="wisdom_2_who">अरस्तू</string>
    <string name="wisdom_2_source">मेटाफ़िज़िक्स, पुस्तक I</string>
    <string name="wisdom_3">बिना परखा हुआ जीवन जीने योग्य नहीं है।</string>
    <string name="wisdom_3_who">सुकरात</string>
    <string name="wisdom_3_source">प्लेटो, एपोलॉजी</string>
    <string name="wisdom_4">आश्चर्य ज्ञान की शुरुआत है।</string>
    <string name="wisdom_4_who">सुकरात</string>
    <string name="wisdom_4_source">प्लेटो, थियेटेटस</string>
    <string name="wisdom_5">स्वयं को जानो।</string>
    <string name="wisdom_5_who">डेल्फ़ी का शिलालेख</string>
    <string name="wisdom_5_source">अपोलो का मंदिर</string>
    <string name="wisdom_6">जो चीज़ें करने के लिए हमें सीखनी होती हैं, उन्हें हम करके सीखते हैं।</string>
    <string name="wisdom_6_who">अरस्तू</string>
    <string name="wisdom_6_source">निकोमैकियन एथिक्स, पुस्तक II</string>
    <string name="wisdom_7">जो आप सोचते हैं कि पहले से जानते हैं, उसे सीखना असंभव है।</string>
    <string name="wisdom_7_who">एपिक्टेटस</string>
    <string name="wisdom_7_source">डिस्कोर्सेज़, पुस्तक II</string>
    <string name="wisdom_8">कोई भी महान चीज़ अचानक नहीं बनती, अंगूर का गुच्छा या अंजीर भी नहीं।</string>
    <string name="wisdom_8_who">एपिक्टेटस</string>
    <string name="wisdom_8_source">डिस्कोर्सेज़, पुस्तक I</string>
    <string name="wisdom_9">पहले खुद से कहिए कि आप क्या बनना चाहते हैं; फिर वह कीजिए जो करना है।</string>
    <string name="wisdom_9_who">एपिक्टेटस</string>
    <string name="wisdom_9_source">डिस्कोर्सेज़, पुस्तक III</string>
    <string name="wisdom_10">शिक्षा की जड़ें कड़वी हैं, पर उसका फल मीठा है।</string>
    <string name="wisdom_10_who">अरस्तू</string>
    <string name="wisdom_10_source">डायोजनीज़ लेर्टियस के अनुसार</string>
    <string name="wisdom_11">शिक्षा बुढ़ापे के लिए सबसे अच्छा सहारा है।</string>
    <string name="wisdom_11_who">अरस्तू</string>
    <string name="wisdom_11_source">डायोजनीज़ लेर्टियस के अनुसार</string>
    <string name="wisdom_12">मन भरने वाला बर्तन नहीं, जलाने वाली लकड़ी है।</string>
    <string name="wisdom_12_who">प्लूटार्क</string>
    <string name="wisdom_12_source">सुनने पर</string>
    <string name="wisdom_13">शुरुआत पूरे का आधा है।</string>
    <string name="wisdom_13_who">अरस्तू</string>
    <string name="wisdom_13_source">पॉलिटिक्स, पुस्तक V</string>
    <string name="wisdom_14">अभ्यास ही सब कुछ है।</string>
    <string name="wisdom_14_who">पेरियांडर</string>
    <string name="wisdom_14_source">डायोजनीज़ लेर्टियस के अनुसार</string>
    <string name="wisdom_15">हमारे दो कान और एक मुँह है, ताकि हम ज़्यादा सुनें और कम बोलें।</string>
    <string name="wisdom_15_who">सिटियम के ज़ेनो</string>
    <string name="wisdom_15_source">डायोजनीज़ लेर्टियस के अनुसार</string>
    <string name="wisdom_16">आपके आदतन विचार जैसे होंगे, आपके मन का स्वभाव भी वैसा ही होगा।</string>
    <string name="wisdom_16_who">मार्कस ऑरेलियस</string>
    <string name="wisdom_16_source">मेडिटेशंस, पुस्तक V</string>
    <string name="wisdom_17">एक अच्छा इंसान कैसा होना चाहिए, इस पर बहस में और समय बर्बाद न करें। वैसे बनें।</string>
    <string name="wisdom_17_who">मार्कस ऑरेलियस</string>
    <string name="wisdom_17_source">मेडिटेशंस, पुस्तक X</string>
    <string name="wisdom_18">आप एक ही नदी में दो बार कदम नहीं रख सकते।</string>
    <string name="wisdom_18_who">हेराक्लिटस</string>
    <string name="wisdom_18_source">प्लेटो के अनुसार, क्रेटिलस</string>
    <string name="tip_1_title">बाँटकर पढ़ें</string>
    <string name="tip_1_body">हफ़्ते भर में फैले कुछ छोटे सत्र एक लंबी रटाई से बेहतर हैं। अंतराल वाला अभ्यास सीखने पर हुए शोध के सबसे पक्के निष्कर्षों में से एक है।</string>
    <string name="tip_2_title">खुद को परखें</string>
    <string name="tip_2_body">पढ़ने के बाद किताब बंद करें और जो याद है उसे लिखें। याद करने की कोशिश दोबारा पढ़ने से कहीं ज़्यादा याददाश्त मज़बूत करती है।</string>
    <string name="tip_3_title">मिलाकर पढ़ें</string>
    <string name="tip_3_body">एक बार में एक ही चीज़ के बजाय विषयों या सवालों के प्रकार बदलते रहें। यह कठिन लगता है, और इसी वजह से काम करता है।</string>
    <string name="tip_4_title">समझाएँ</string>
    <string name="tip_4_body">विचार को आसान शब्दों में समझाएँ, जैसे किसी जिज्ञासु बारह साल के बच्चे को। आपकी व्याख्या की कमियाँ आपकी समझ की कमियाँ हैं।</string>
    <string name="tip_5_title">कब और कहाँ तय करें</string>
    <string name="tip_5_body">\"मैं शाम 7 बजे रसोई की मेज़ पर पढ़ूँगा\" कहना \"आज रात पढ़ लूँगा\" से कहीं ज़्यादा असरदार है।</string>
    <string name="tip_6_title">नींद लें</string>
    <string name="tip_6_body">नींद दिन भर में सीखी बातों को पक्का करती है। देर रात की रटाई अक्सर फ़ायदे से ज़्यादा नुकसान करती है।</string>
    <string name="tip_7_title">आराम से थोड़ा आगे</string>
    <string name="tip_7_body">ऐसे अभ्यास चुनें जो थोड़े ज़्यादा कठिन हों। अगर आसान लगे, तो आप दोहरा रहे हैं, सीख नहीं रहे।</string>
    <string name="tip_8_title">एक पंक्ति का चिंतन</string>
    <string name="tip_8_body">सत्र को \"मैंने सीखी एक बात\" के साथ खत्म करना एक छोटा-सा याद करने का अभ्यास है, जो आपकी प्रगति भी दिखाता है।</string>
    <string name="tip_9_title">फ़ोकस बचाएँ</string>
    <string name="tip_9_body">फ़ोकस ब्लॉक के दौरान फ़ोन दूसरे कमरे में रखें। मेज़ पर उल्टा रखा फ़ोन भी ध्यान खींच सकता है।</string>
    <string name="tip_10_title">जोड़ें</string>
    <string name="tip_10_body">पूछें: \"यह उस चीज़ से कैसे जुड़ता है जो मैं पहले से जानता हूँ?\" जुड़े हुए विचार बाद में आसानी से याद आते हैं।</string>
    <string name="tip_11_title">चूक को माफ़ करें</string>
    <string name="tip_11_body">एक दिन छूटने से आदत नहीं टूटती। ज़रूरी है अगले दिन फिर शुरू करना।</string>
    <string name="tip_12_title">शब्द + चित्र</string>
    <string name="tip_12_body">जो सीख रहे हैं उसका झटपट चित्र बनाएँ। चित्र और शब्द मिलकर याददाश्त को दो रास्ते देते हैं।</string>
    <string name="tip_13_title">क्यों पूछें</string>
    <string name="tip_13_body">पढ़ते समय बार-बार पूछें: \"यह सच क्यों है?\" खुद को समझाने से तथ्य समझ में बदलते हैं।</string>
    <string name="tip_14_title">योजना के साथ खत्म करें</string>
    <string name="tip_14_body">हर सत्र के अंत में लिखें कि अगली बार कहाँ से शुरू करेंगे। शुरू करना सबसे कठिन है, इसे भविष्य के अपने लिए आसान बनाएँ।</string>
