<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the study database and settings to the user's Google account,
     and carry them over on device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="backgrounds/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="backgrounds/" />
    </device-transfer>
</data-extraction-rules>
