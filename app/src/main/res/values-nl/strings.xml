    <string name="title_scribe_meaning">hoeder van woorden</string>
    <string name="title_rhetor">Retor</string>
    <string name="title_rhetor_meaning">wie met een doel spreekt</string>
    <string name="title_scholar">Geleerde</string>
    <string name="title_scholar_meaning">toegewijd aan kennis</string>
    <string name="title_sage">Wijze</string>
    <string name="title_sage_meaning">de wijze</string>
    <string name="title_philosopher">Filosoof</string>
    <string name="title_philosopher_meaning">vriend van de wijsheid</string>
    <string name="wisdom_1">Ik word oud en leer nog steeds veel bij.</string>
    <string name="wisdom_1_who">Solon</string>
    <string name="wisdom_1_source">fragment, geciteerd door Plato en Plutarchus</string>
    <string name="wisdom_2">Alle mensen streven van nature naar kennis.</string>
    <string name="wisdom_2_who">Aristoteles</string>
    <string name="wisdom_2_source">Metafysica, boek I</string>
    <string name="wisdom_3">Een leven zonder onderzoek is het niet waard geleefd te worden.</string>
    <string name="wisdom_3_who">Socrates</string>
    <string name="wisdom_3_source">Plato, Apologie</string>
    <string name="wisdom_4">Verwondering is het begin van wijsheid.</string>
    <string name="wisdom_4_who">Socrates</string>
    <string name="wisdom_4_source">Plato, Theaetetus</string>
    <string name="wisdom_5">Ken uzelf.</string>
    <string name="wisdom_5_who">Inscriptie in Delphi</string>
    <string name="wisdom_5_source">Tempel van Apollo</string>
    <string name="wisdom_6">Wat we moeten leren om het te doen, leren we door het te doen.</string>
    <string name="wisdom_6_who">Aristoteles</string>
    <string name="wisdom_6_source">Ethica Nicomachea, boek II</string>
    <string name="wisdom_7">Het is onmogelijk iets te leren wat je denkt al te weten.</string>
    <string name="wisdom_7_who">Epictetus</string>
    <string name="wisdom_7_source">Diatriben, boek II</string>
    <string name="wisdom_8">Niets groots ontstaat plotseling, net zo min als een tros druiven of een vijg.</string>
    <string name="wisdom_8_who">Epictetus</string>
    <string name="wisdom_8_source">Diatriben, boek I</string>
    <string name="wisdom_9">Zeg eerst tegen jezelf wie je wilt zijn; doe dan wat je moet doen.</string>
    <string name="wisdom_9_who">Epictetus</string>
    <string name="wisdom_9_source">Diatriben, boek III</string>
    <string name="wisdom_10">De wortels van onderwijs zijn bitter, maar de vruchten zijn zoet.</string>
    <string name="wisdom_10_who">Aristoteles</string>
    <string name="wisdom_10_source">volgens Diogenes Laërtius</string>
    <string name="wisdom_11">Onderwijs is de beste voorraad voor de oude dag.</string>
    <string name="wisdom_11_who">Aristoteles</string>
    <string name="wisdom_11_source">volgens Diogenes Laërtius</string>
    <string name="wisdom_12">De geest is geen vat dat gevuld moet worden, maar hout dat ontstoken moet worden.</string>
    <string name="wisdom_12_who">Plutarchus</string>
    <string name="wisdom_12_source">Over het luisteren</string>
    <string name="wisdom_13">Het begin is de helft van het geheel.</string>
    <string name="wisdom_13_who">Aristoteles</string>
    <string name="wisdom_13_source">Politica, boek V</string>
    <string name="wisdom_14">Oefening is alles.</string>
    <string name="wisdom_14_who">Periander</string>
    <string name="wisdom_14_source">volgens Diogenes Laërtius</string>
    <string name="wisdom_15">We hebben twee oren en één mond, zodat we meer luisteren en minder praten.</string>
    <string name="wisdom_15_who">Zeno van Citium</string>
    <string name="wisdom_15_source">volgens Diogenes Laërtius</string>
    <string name="wisdom_16">Zoals je gewoonlijke gedachten zijn, zo wordt ook het karakter van je geest.</string>
    <string name="wisdom_16_who">Marcus Aurelius</string>
    <string name="wisdom_16_source">Overpeinzingen, boek V</string>
    <string name="wisdom_17">Verspil geen tijd meer aan discussies over wat een goed mens is. Wees er een.</string>
    <string name="wisdom_17_who">Marcus Aurelius</string>
    <string name="wisdom_17_source">Overpeinzingen, boek X</string>
    <string name="wisdom_18">Je kunt niet twee keer in dezelfde rivier stappen.</string>
    <string name="wisdom_18_who">Heraclitus</string>
    <string name="wisdom_18_source">volgens Plato, Cratylus</string>
    <string name="tip_1_title">Spreid het</string>
    <string name="tip_1_body">Een paar korte sessies verspreid over de week verslaan één lange blokavond. Gespreid leren is een van de best onderbouwde bevindingen uit het leeronderzoek.</string>
    <string name="tip_2_title">Overhoor jezelf</string>
    <string name="tip_2_body">Sla na het lezen het boek dicht en schrijf op wat je je herinnert. Ophalen versterkt het geheugen veel meer dan herlezen.</string>
    <string name="tip_3_title">Wissel af</string>
    <string name="tip_3_body">Wissel onderwerpen of soorten opgaven af in plaats van er één tegelijk te oefenen. Het voelt moeilijker, en daarom werkt het juist.</string>
    <string name="tip_4_title">Leg het uit</string>
    <string name="tip_4_body">Leg het idee in eenvoudige woorden uit, als aan een nieuwsgierige twaalfjarige. Gaten in je uitleg zijn gaten in je begrip.</string>
    <string name="tip_5_title">Kies wanneer en waar</string>
    <string name="tip_5_body">\'Ik leer om 19.00 uur aan de keukentafel\' maakt het veel waarschijnlijker dat je het doet dan \'ik leer vanavond\'.</string>
    <string name="tip_6_title">Slaap erop</string>
    <string name="tip_6_body">Slaap zet vast wat je overdag hebt geleerd. Laat doorblokken kost vaak meer dan het oplevert.</string>
    <string name="tip_7_title">Net voorbij comfortabel</string>
    <string name="tip_7_body">Kies oefeningen die net iets te moeilijk zijn. Voelt het makkelijk, dan herhaal je, je leert niet.</string>
    <string name="tip_8_title">Reflectie in één regel</string>
    <string name="tip_8_body">Een sessie afsluiten met \'één ding dat ik heb geleerd\' is een kleine ophaaloefening die je ook je vooruitgang laat zien.</string>
    <string name="tip_9_title">Bescherm je focus</string>
    <string name="tip_9_body">Leg je telefoon tijdens een focusblok in een andere kamer. Zelfs omgekeerd op tafel kan hij aandacht kosten.</string>
    <string name="tip_10_title">Verbind het</string>
    <string name="tip_10_body">Vraag je af: \'Hoe hangt dit samen met iets wat ik al weet?\' Verbonden ideeën zijn later makkelijker terug te halen.</string>
    <string name="tip_11_title">Vergeef de gaten</string>
    <string name="tip_11_body">Eén gemiste dag maakt een gewoonte niet kapot. Wat telt is de volgende dag weer verder gaan.</string>
    <string name="tip_12_title">Woorden + beelden</string>
    <string name="tip_12_body">Schets snel een diagram van wat je leert. Beelden en woorden samen geven je geheugen twee ingangen.</string>
    <string name="tip_13_title">Vraag waarom</string>
    <string name="tip_13_body">Blijf jezelf tijdens het lezen afvragen: \'Waarom klopt dit?\' Zelfuitleg maakt van feiten begrip.</string>
    <string name="tip_14_title">Sluit af met een plan</string>
    <string name="tip_14_body">Noteer aan het eind van elke sessie waar je de volgende keer begint. Beginnen is het moeilijkst: maak het makkelijk voor je toekomstige zelf.</string>
