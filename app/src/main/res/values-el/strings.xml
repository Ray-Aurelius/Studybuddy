    <string name="wisdom_1">Γηράσκω δ\' αἰεὶ πολλὰ διδασκόμενος.</string>
    <string name="wisdom_1_who">Σόλων</string>
    <string name="wisdom_1_source">απόσπασμα, κατά Πλάτωνα και Πλούταρχο</string>
    <string name="wisdom_2">Πάντες ἄνθρωποι τοῦ εἰδέναι ὀρέγονται φύσει.</string>
    <string name="wisdom_2_who">Αριστοτέλης</string>
    <string name="wisdom_2_source">Τα μετά τα φυσικά, βιβλίο Α</string>
    <string name="wisdom_3">Ὁ ἀνεξέταστος βίος οὐ βιωτὸς ἀνθρώπῳ.</string>
    <string name="wisdom_3_who">Σωκράτης</string>
    <string name="wisdom_3_source">Πλάτων, Απολογία</string>
    <string name="wisdom_4">Το θαυμάζειν είναι η αρχή της φιλοσοφίας.</string>
    <string name="wisdom_4_who">Σωκράτης</string>
    <string name="wisdom_4_source">Πλάτων, Θεαίτητος</string>
    <string name="wisdom_5">Γνῶθι σαυτόν.</string>
    <string name="wisdom_5_who">Επιγραφή των Δελφών</string>
    <string name="wisdom_5_source">Ναός του Απόλλωνα</string>
    <string name="wisdom_6">Όσα πρέπει να μάθουμε για να τα κάνουμε, τα μαθαίνουμε κάνοντάς τα.</string>
    <string name="wisdom_6_who">Αριστοτέλης</string>
    <string name="wisdom_6_source">Ηθικά Νικομάχεια, βιβλίο Β</string>
    <string name="wisdom_7">Είναι αδύνατον να μάθει κανείς αυτό που νομίζει ότι ήδη ξέρει.</string>
    <string name="wisdom_7_who">Επίκτητος</string>
    <string name="wisdom_7_source">Διατριβαί, βιβλίο Β</string>
    <string name="wisdom_8">Τίποτα μεγάλο δεν γίνεται ξαφνικά, όπως ούτε ένα τσαμπί σταφύλι ούτε ένα σύκο.</string>
    <string name="wisdom_8_who">Επίκτητος</string>
    <string name="wisdom_8_source">Διατριβαί, βιβλίο Α</string>
    <string name="wisdom_9">Πες πρώτα στον εαυτό σου τι θέλεις να είσαι· έπειτα κάνε ό,τι πρέπει.</string>
    <string name="wisdom_9_who">Επίκτητος</string>
    <string name="wisdom_9_source">Διατριβαί, βιβλίο Γ</string>
    <string name="wisdom_10">Της παιδείας οι ρίζες είναι πικρές, αλλά οι καρποί γλυκοί.</string>
    <string name="wisdom_10_who">Αριστοτέλης</string>
    <string name="wisdom_10_source">κατά Διογένη Λαέρτιο</string>
    <string name="wisdom_11">Η παιδεία είναι το καλύτερο εφόδιο για τα γηρατειά.</string>
    <string name="wisdom_11_who">Αριστοτέλης</string>
    <string name="wisdom_11_source">κατά Διογένη Λαέρτιο</string>
    <string name="wisdom_12">Ο νους δεν είναι αγγείο που χρειάζεται γέμισμα, αλλά ξύλο που χρειάζεται άναμμα.</string>
    <string name="wisdom_12_who">Πλούταρχος</string>
    <string name="wisdom_12_source">Περί του ακούειν</string>
    <string name="wisdom_13">Ἀρχὴ ἥμισυ παντός.</string>
    <string name="wisdom_13_who">Αριστοτέλης</string>
    <string name="wisdom_13_source">Πολιτικά, βιβλίο Ε</string>
    <string name="wisdom_14">Μελέτη τὸ πᾶν.</string>
    <string name="wisdom_14_who">Περίανδρος</string>
    <string name="wisdom_14_source">κατά Διογένη Λαέρτιο</string>
    <string name="wisdom_15">Έχουμε δύο αυτιά και ένα στόμα, για να ακούμε περισσότερα και να μιλάμε λιγότερα.</string>
    <string name="wisdom_15_who">Ζήνων ο Κιτιεύς</string>
    <string name="wisdom_15_source">κατά Διογένη Λαέρτιο</string>
    <string name="wisdom_16">Όποιες είναι οι συνήθεις σκέψεις σου, τέτοιος θα είναι και ο χαρακτήρας του νου σου.</string>
    <string name="wisdom_16_who">Μάρκος Αυρήλιος</string>
    <string name="wisdom_16_source">Τα εις εαυτόν, βιβλίο Ε</string>
    <string name="wisdom_17">Μη χάνεις πια χρόνο συζητώντας πώς πρέπει να είναι ο καλός άνθρωπος. Γίνε ένας.</string>
    <string name="wisdom_17_who">Μάρκος Αυρήλιος</string>
    <string name="wisdom_17_source">Τα εις εαυτόν, βιβλίο Ι</string>
    <string name="wisdom_18">Δεν μπορείς να μπεις δύο φορές στο ίδιο ποτάμι.</string>
    <string name="wisdom_18_who">Ηράκλειτος</string>
    <string name="wisdom_18_source">κατά Πλάτωνα, Κρατύλος</string>
    <string name="tip_1_title">Μοίρασέ το</string>
    <string name="tip_1_body">Λίγες σύντομες συνεδρίες μέσα στην εβδομάδα νικούν ένα μακρύ διάβασμα της τελευταίας στιγμής. Η κατανεμημένη εξάσκηση είναι από τα πιο επιβεβαιωμένα ευρήματα της έρευνας για τη μάθηση.</string>
    <string name="tip_2_title">Εξέτασε τον εαυτό σου</string>
    <string name="tip_2_body">Αφού διαβάσεις, κλείσε το βιβλίο και γράψε ό,τι θυμάσαι. Η ανάκληση δυναμώνει τη μνήμη πολύ περισσότερο από το ξαναδιάβασμα.</string>
    <string name="tip_3_title">Ανακάτεψέ το</string>
    <string name="tip_3_body">Εναλλάξ θέματα ή τύπους ασκήσεων αντί για ένα κάθε φορά. Φαίνεται πιο δύσκολο, και γι\' αυτό ακριβώς πιάνει.</string>
    <string name="tip_4_title">Εξήγησέ το</string>
    <string name="tip_4_body">Εξήγησε την ιδέα με απλά λόγια, σαν σε ένα περίεργο δωδεκάχρονο. Τα κενά στην εξήγηση είναι κενά στην κατανόηση.</string>
    <string name="tip_5_title">Όρισε πότε και πού</string>
    <string name="tip_5_body">«Θα μελετήσω στις 7 μ.μ. στο τραπέζι της κουζίνας» κάνει πολύ πιο πιθανό να το κάνεις από το «θα μελετήσω απόψε».</string>
    <string name="tip_6_title">Κοιμήσου το</string>
    <string name="tip_6_body">Ο ύπνος σταθεροποιεί ό,τι έμαθες μέσα στη μέρα. Το ξενύχτι πάνω από τα βιβλία συχνά κοστίζει περισσότερο απ\' όσο αποδίδει.</string>
    <string name="tip_7_title">Λίγο πέρα από το άνετο</string>
    <string name="tip_7_body">Διάλεξε ασκήσεις λίγο πιο δύσκολες απ\' όσο θα ήθελες. Αν είναι εύκολο, επαναλαμβάνεις, δεν μαθαίνεις.</string>
    <string name="tip_8_title">Στοχασμός μιας γραμμής</string>
    <string name="tip_8_body">Να κλείνεις μια συνεδρία με «ένα πράγμα που έμαθα» είναι μικρή άσκηση ανάκλησης που σου δείχνει και την πρόοδό σου.</string>
    <string name="tip_9_title">Προστάτεψε τη συγκέντρωση</string>
    <string name="tip_9_body">Σε ένα μπλοκ συγκέντρωσης άφησε το κινητό σε άλλο δωμάτιο. Ακόμα και ανάποδα στο τραπέζι μπορεί να σου τραβά την προσοχή.</string>
    <string name="tip_10_title">Σύνδεσέ το</string>
    <string name="tip_10_body">Ρώτα: «Πώς συνδέεται αυτό με κάτι που ήδη ξέρω;» Οι συνδεδεμένες ιδέες ανακαλούνται πιο εύκολα.</string>
    <string name="tip_11_title">Συγχώρεσε τα κενά</string>
    <string name="tip_11_body">Μια μέρα που έχασες δεν χαλάει μια συνήθεια. Σημασία έχει να συνεχίσεις την επόμενη.</string>
    <string name="tip_12_title">Λέξεις + εικόνες</string>
    <string name="tip_12_body">Σχεδίασε γρήγορα ένα διάγραμμα αυτού που μαθαίνεις. Εικόνες και λέξεις μαζί δίνουν στη μνήμη δύο δρόμους.</string>
    <string name="tip_13_title">Ρώτα γιατί</string>
    <string name="tip_13_body">Καθώς διαβάζεις, ρώτα συνέχεια: «Γιατί ισχύει αυτό;» Η αυτοεξήγηση κάνει τα γεγονότα κατανόηση.</string>
    <string name="tip_14_title">Κλείσε με σχέδιο</string>
    <string name="tip_14_body">Στο τέλος κάθε συνεδρίας σημείωσε από πού θα ξεκινήσεις την επόμενη φορά. Η αρχή είναι το πιο δύσκολο· κάν\' τη εύκολη για τον μελλοντικό σου εαυτό.</string>
